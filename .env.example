# ==============================================================================
# NemoForge Configuration - Powered by NVIDIA Nemotron & Nebius Token Factory
# ==============================================================================

# Core Provider: 'nebius' (or 'openai', 'anthropic', 'google')
LLM_PROVIDER=nebius

# Nebius Token Factory Credentials (for NVIDIA open models)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Primary NVIDIA Model (Hosted on Nebius Token Factory)
LLM_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b

# Optional Alternate NVIDIA Models:
# LLM_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct
# LLM_MODEL=nebius/nvidia/nemotron-3.5-super-vl

# Server Port
PORT=8002
